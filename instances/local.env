FEDIVID_INSTANCE_NAME=local
FEDIVID_INSTANCE_DESCRIPTION="Main development instance"
FEDIVID_SCHEME=http
FEDIVID_DOMAIN=localhost:3000
FEDIVID_BASE_URL=http://localhost:3000
FEDIVID_LISTEN=http://127.0.0.1:3000
FEDIVID_DATABASE_URL=postgresql://postgres:1234pass@localhost/fedivid_local
FEDIVID_UPLOAD_DIR=uploads/local
FEDIVID_SESSION_SECRET=local-dev-session-secret-change-in-prod
FEDIVID_ADMIN_SECRET=test-admin-token
FEDIVID_ALLOW_SIGNUP=1

FEDIVID_ALLOW_INSECURE_FETCH=1

FEDIVID_INSTANCE_CONTACT=admin@example.com
FEDIVID_INSTANCE_RULES="Be kind.|No spam.|No NSFW without a warning."
FEDIVID_INSTANCE_BANNER=

FEDIVID_INSTANCE_CATEGORIES="music|gaming|tech|vlog|sports"
